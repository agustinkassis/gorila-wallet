// Local wallet cache + user metadata. Chain-scoped rows use chain = "btc" | "xbt".
// Values are satoshis (BigInt). Electrum stays the source of truth; this is a warm, indexed cache.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A wallet: the .env seed (kind "env"), a software wallet created/imported in the app ("seed"),
/// or a watch-only xpub ("watch"). Software seeds are stored encrypted with the wallet's password.
model Wallet {
  id          String   @id
  name        String
  kind        String // env | seed | watch
  xpub        String
  path        String
  fingerprint Int
  /// seed wallets: scrypt + AES-256-GCM sealed JSON {mnemonic, passphrase}
  encSeed     String?
  /// a BIP39 passphrase is part of this wallet (shown in the UI, never stored in clear)
  passphrase  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Nostr pubkeys allowed to log in (besides ALLOWED_PUBKEYS). With neither, the first login claims ownership.
model Account {
  pubkey    String   @id
  createdAt DateTime @default(now())
}

/// Addresses derived from a wallet's account xpub (identical on both chains).
model Address {
  walletId   String
  address    String
  change     Int // 0 = receive, 1 = change
  index      Int
  scripthash String

  @@id([walletId, address])
  @@unique([walletId, scripthash])
  @@unique([walletId, change, index])
}

/// Per-chain sync state of an address. `status` is the Electrum status hash: unchanged => skip resync.
model AddressState {
  walletId    String
  chain       String
  address     String
  status      String?
  used        Boolean @default(false)
  confirmed   BigInt  @default(0)
  unconfirmed BigInt  @default(0)
  /// JSON [[txid, height], ...] from the last get_history: lets us GC replaced/evicted txs without refetching everything
  history     String  @default("[]")

  @@id([walletId, chain, address])
  @@index([walletId, chain, used])
}

model Utxo {
  walletId String
  chain    String
  txid     String
  vout     Int
  address  String
  value    BigInt
  height   Int // <= 0 while unconfirmed

  @@id([walletId, chain, txid, vout])
  @@index([walletId, chain, address])
}

/// Wallet transactions (net effect on our addresses).
model Tx {
  walletId String
  chain    String
  txid     String
  height   Int
  time     Int?
  amount   BigInt
  fee      BigInt?
  vsize    Int?

  @@id([walletId, chain, txid])
  @@index([walletId, chain, height])
}

/// Immutable raw transaction cache (wallet txs and their parents).
model RawTx {
  chain String
  txid  String
  hex   String

  @@id([chain, txid])
}

/// Block timestamp cache.
model Header {
  chain  String
  height Int
  time   Int

  @@id([chain, height])
}

/// BIP-329 style labels. type: tx | addr | output (ref "txid:vout"). spendable=false => frozen.
model Label {
  walletId  String
  chain     String
  type      String
  ref       String
  label     String?
  spendable Boolean?

  @@id([walletId, chain, type, ref])
}

model Setting {
  key   String @id
  value String // JSON
}
